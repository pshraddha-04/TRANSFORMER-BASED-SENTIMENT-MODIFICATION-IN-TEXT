APP_NAME=Transformer Sentiment Transformation API
APP_VERSION=1.1.0
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Comma-separated values
ALLOWED_ORIGINS=https://your-frontend.example.com
TRUSTED_HOSTS=api.example.com

# Leave empty to disable API key auth
API_KEY=

# Optional model overrides
DEFAULT_EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
DEFAULT_REWRITER_MODEL=google/flan-t5-small

# Set to 1 only for local smoke tests (disables transformer loading)
LIGHTWEIGHT_MODE=0

# Training quality gates
MIN_TRAIN_ROWS=8
MIN_ROWS_PER_LABEL=2
MIN_UNIQUE_TEXT_RATIO=0.4

# Drift monitoring
DRIFT_LOG_EVERY_N=25
DRIFT_DOMINANCE_THRESHOLD=0.85

